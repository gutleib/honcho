# Honcho — Russian Self-Hosted Environment
# =============================================================================
# Адаптировано для:
#   - DeepSeek API (LLM — deriver, dialectic, summarizer, dreamer)
#   - Infinity (эмбеддинги) — BAAI/bge-m3, 1024-dim
#   - PostgreSQL + pgvector (через docker compose)
#   - Redis (кеш)
#
# Порядок настройки:
#   1. Скопировать этот файл в .env
#   2. Заменить *** на реальные значения
#   3. docker compose -f docker-compose.selfhosted.yml up -d --build

# =============================================================================
# Обязательно: LLM-провайдер
# =============================================================================
LLM_OPENAI_API_KEY=***

# =============================================================================
# DeepSeek API (OpenAI-совместимый эндпоинт)
# =============================================================================
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
DERIVER_MODEL_CONFIG__MODEL=deepseek-chat
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small

# =============================================================================
# Эмбеддинги — Infinity (локальные, BAAI/bge-m3, 1024-dim)
# =============================================================================
EMBEDDING_VECTOR_DIMENSIONS=1024
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://embedding:7997
EMBEDDING_MODEL_CONFIG__MODEL=BAAI/bge-m3

# =============================================================================
# Dialectic — DeepSeek на всех уровнях
# =============================================================================
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=deepseek-chat
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=deepseek-chat
DIALECTIC_LEVELS__low__MODEL_CONFIG__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=deepseek-chat
DIALECTIC_LEVELS__medium__MODEL_CONFIG__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=deepseek-chat
DIALECTIC_LEVELS__high__MODEL_CONFIG__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=deepseek-chat
DIALECTIC_LEVELS__max__MODEL_CONFIG__BASE_URL=https://api.deepseek.com/v1

DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# Аутентификация
# =============================================================================
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=***
HONCHO_API_KEY=***

# =============================================================================
# Пароли (должны совпадать с docker-compose)
# =============================================================================
POSTGRES_PASSWORD=***
REDIS_PASSWORD=***

# =============================================================================
# Настройки приложения
# =============================================================================
LOG_LEVEL=INFO
CACHE_ENABLED=true
DERIVER_ENABLED=true
DERIVER_WORKERS=1

# =============================================================================
# Настройки БД
# =============================================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
VECTOR_STORE_TYPE=pgvector

# =============================================================================
# Отключение телеметрии
# =============================================================================
DO_NOT_TRACK=1
